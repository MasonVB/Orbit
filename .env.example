# Copy to .env and edit. .env is gitignored - keep real passwords out of the repo.
#
#   cp .env.example .env

# Seeds the first account. Ignored once that account exists.
ORBIT_ADMIN_USER=admin
ORBIT_ADMIN_PASSWORD=change-me

# Must match the address you actually reach Orbit on, or copied share links 404.
ORBIT_PUBLIC_URL=https://orbit.agrabah.app

# horizon | full | none
ORBIT_MAX360_STABILISE=horizon

# Solve a calibration automatically on first import from an unknown camera.
ORBIT_AUTO_SOLVE=1

TZ=America/Los_Angeles

# Where Orbit keeps originals, derivatives and its database.
ORBIT_DATA_DIR=./data

# Image to run. Set to your own once CI has published it.
ORBIT_IMAGE=ghcr.io/YOURUSER/orbit:latest
